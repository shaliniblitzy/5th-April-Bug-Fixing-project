# Blitzy Platform API Configuration
# Copy this file to .env and fill in the values

# Base URL of the Blitzy Platform API (e.g., https://api.blitzy.com)
API_BASE_URL=

# Bearer token for authenticating API requests
API_AUTH_TOKEN=

# Default project ID for test targeting
PROJECT_ID=

# HTTP request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30
