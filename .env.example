# Blitzy Platform API Test Suite — Environment Configuration
# Copy this file to .env and replace the placeholder values with your actual credentials.
# Do NOT commit the .env file to version control.

# Base URL for the Blitzy Platform API
API_BASE_URL=https://api.blitzy.com

# Authentication bearer token for API requests
API_AUTH_TOKEN=your-auth-token-here

# Target project identifier for test execution
PROJECT_ID=your-project-id-here

# HTTP request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30
